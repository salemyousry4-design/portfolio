# EmailJS for the Contact form (account: Salem's email).
# Copy this file to .env.local and fill in the 3 values from https://dashboard.emailjs.com
#   Service ID  -> Email Services -> Add Service (Gmail)
#   Template ID -> Email Templates -> Create (use {{name}}, {{email}}, {{subject}}, {{message}})
#   Public Key  -> Account -> General
# On Vercel, add the same 3 variables under Project Settings -> Environment Variables.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# Public URL of the deployed site (used for the share/OG image), e.g. https://salem-yousry.vercel.app
NEXT_PUBLIC_SITE_URL=
